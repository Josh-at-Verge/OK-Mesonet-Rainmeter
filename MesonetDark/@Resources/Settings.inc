; Shared settings for all five skins. Save, then Refresh each loaded skin.
; Four-letter Mesonet station ID; Norman is NRMN. Letter case does not matter.
Station=NRMN
; 1 = dark iframe filter, 0 = original Mesonet colors (frame stays dark).
Dark=1
; Reload the embedded widget every 300 seconds. 0 disables scheduled reloads.
; Positive values are clamped to 60..3600 seconds by the wrapper.
RefreshSeconds=300
; Display scale. Suggested range 0.75..1.5; 1 is the published widget size.
Scale=1
